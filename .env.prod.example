# Template of the Environment tab of the Dokploy Compose service (feat-218): paste it there and fill
# the values. Dokploy writes them into `.env` next to docker-compose-prod.yml. Guide:
# documentation/guide/deployment-dokploy.md. Placeholders only: never commit real values.
#
# Required variables are marked [required]: docker-compose-prod.yml stops the deploy without them.
# Fixed in the compose file, do not set here: APP_ENV, APP_IS_PRODUCTION, NODE_ENV, SERVE_STATIC,
# SESSION_COOKIE_HOST_PREFIX, TRUST_PROXY, DOC_PAGE, APP_URL, FRONTEND_URL, DOMAIN, LANDING_URL,
# CSRF_ALLOWED_ORIGINS, WEBAUTHN_RP_ID (all derived from the two domains below).

# --- Domains [required] ---------------------------------------------------------------------
# Hosts only, without https:// and without a path. The same hosts go to the Domains tab:
# APP_DOMAIN → service app, port 3000; LANDING_DOMAIN → service landing, port 8080; HTTPS on.
# The passkeys are bound to APP_DOMAIN for good: changing it later makes them unusable.
APP_DOMAIN=app.example.com
LANDING_DOMAIN=example.com

# --- Build of the SPA -------------------------------------------------------------------------
# Compiled into the SPA and read by the server: one value for both (empty → api).
API_PATH_PREFIX=api
# Browser error reporting (optional).
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=
# The landing build refuses http, localhost and placeholder addresses; keep true on a server.
LANDING_STRICT=true

# --- Secrets of the application [required] ----------------------------------------------------
# openssl rand -base64 48
APP_KEY=
# `<keyId>:<base64 of 32 bytes>`; generate with `pnpm --filter backend mfa:keys` on your machine,
# or `echo "k1:$(openssl rand -base64 32)"`. Losing it makes every TOTP factor unusable.
MFA_ENCRYPTION_KEYS=

# --- Databases of Dokploy [required] -----------------------------------------------------------
# From the Internal Credentials of the Database services (General tab). The host is the App Name
# of the service; the port is the container port (External Port stays empty).
PGSQL_HOST=vibe-postgres-xxxxxx
PGSQL_PORT=5432
PGSQL_USER=postgres
PGSQL_PASSWORD=
PGSQL_DB_NAME=vibe_template
# TLS to PostgreSQL: false inside dokploy-network (the database has no External Port).
PGSQL_SSL=false
REDIS_HOST=vibe-redis-xxxxxx
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Proxy [required] -------------------------------------------------------------------------
# The subnet of dokploy-network, where Traefik lives: on the server,
#   docker network inspect dokploy-network --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXY_CIDRS=10.0.1.0/24

# --- S3: Hetzner Object Storage [required] ----------------------------------------------------
# Bucket CORS: corsS3.prod.example.xml. CDN_URL is the public address files are read from.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=vibe-template
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_URL=https://vibe-template.fsn1.your-objectstorage.com
S3_PREFIX=app

# --- Mail: any SMTP provider ------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_FROM_EMAIL=noreply@example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# --- Optional -----------------------------------------------------------------------------------
# Everything else of packages/backend/.env.example passes through as well (env_file), for example:
# Web push: pnpm --filter backend push:vapid (on your machine), then the three values.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Server error reporting.
SENTRY_ENABLED=false
SENTRY_DSN=
# OAuth providers (optional): the callback is https://<APP_DOMAIN>/<API_PATH_PREFIX>/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# AI of the support chat.
OPENAI_API_KEY=
# No demo accounts in production: the first admin is described in documentation/backend/database.md
# ("The first admin in production").
