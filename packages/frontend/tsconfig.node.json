{
    "extends": "@tsconfig/node24/tsconfig.json",
    "include": [
        "vite.config.*",
        "vite.sw.config.ts",
        "vite.console.ts",
        "vitest.config.*",
        "cypress.config.*",
        "nightwatch.conf.*",
        "playwright.config.*",
        "playwright.csp.config.*",
        "playwright.security.config.*",
        "playwright.live.config.*",
        "e2e-security/fixtures.ts",
        "e2e-live/fixtures.ts",
        "eslint.config.*"
    ],
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"]
    }
}
