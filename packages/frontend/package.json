{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" -- && pnpm run build-sw",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:security": "../../scripts/prod-local.sh --build-only && playwright test -c playwright.security.config.ts",
        "test:e2e:live": "PORT=3100 VITE_AUTH_PHONE_ENABLED=false ../../scripts/prod-local.sh --build-only && playwright test -c playwright.live.config.ts",
        "test:e2e:csp": "../../scripts/prod-local.sh --build-only && CSP_E2E_MODE=enforce playwright test -c playwright.csp.config.ts && CSP_E2E_MODE=report-only playwright test -c playwright.csp.config.ts",
        "build-only": "vite build",
        "build-sw": "vite build --config vite.sw.config.ts",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix",
        "format": "prettier --write src/",
        "typecheck": "vue-tsc --build --force && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p e2e-security/tsconfig.json && tsc --noEmit -p e2e-live/tsconfig.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=html",
        "lint:check": "eslint ."
    },
    "dependencies": {
        "@khmyznikov/pwa-install": "^0.7.0",
        "@sentry/vue": "^11.10.0",
        "@vue/devtools-api": "^8.2.1",
        "@vueuse/core": "^15.0.0",
        "dompurify": "^3.4.17",
        "mitt": "^3.0.1",
        "pinia": "^4.1.0",
        "shared": "workspace:*",
        "vue": "^3.5.44",
        "vue-advanced-cropper": "^2.8.9",
        "vue-i18n": "^11.4.16",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tsconfig/node24": "^24.0.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/eslint-plugin": "^1.6.28",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-vue": "~10.12.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "npm-run-all2": "^9.0.4",
        "typescript": "6.0.3",
        "vite": "^7.3.7",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.14"
    }
}
