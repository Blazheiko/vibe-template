{
    "name": "backend",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#app/*": "./dist/app/*",
        "#config/*": "./dist/config/*",
        "#vendor/*": "./dist/vendor/*",
        "#database/*": "./dist/database/*",
        "#logger": "./dist/vendor/utils/logger.js",
        "#drizzle/*": "./dist/drizzle/*"
    },
    "scripts": {
        "build": "tsc --build",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "clean": "rm -rf dist .tsbuildinfo",
        "typecheck": "tsc --noEmit",
        "db:create": "tsx src/db/create-database.ts",
        "db:create:prod": "node dist/db/create-database.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx src/db/seed.ts",
        "db:seed:prod": "node dist/db/seed.js",
        "mail:test": "tsx src/scripts/send-test-email.ts",
        "push:vapid": "tsx src/scripts/generate-vapid-keys.ts",
        "bench:response": "tsx src/scripts/bench-response-check.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=html",
        "test:watch": "vitest",
        "test:redis": "vitest run --config vitest.redis.config.ts",
        "test:pg": "vitest run --config vitest.pg.config.ts"
    },
    "dependencies": {
        "@ai-sdk/xai": "5.0.35",
        "@arktype/type": "2.2.9",
        "@aws-sdk/client-s3": "3.1161.0",
        "@aws-sdk/s3-request-presigner": "3.1161.0",
        "@mistralai/mistralai": "2.7.0",
        "@sentry/node": "11.10.0",
        "ai": "7.0.159",
        "arctic": "3.7.0",
        "better-result": "3.0.1",
        "dotenv": "18.0.9",
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "ioredis": "6.0.0",
        "luxon": "3.7.2",
        "metautil": "5.5.2",
        "nanoid": "6.0.2",
        "nodemailer": "10.3.1",
        "openai": "7.47.0",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "pino-pretty": "13.2.0",
        "shared": "workspace:*",
        "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0",
        "web-push": "3.6.7"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.6",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/web-push": "^3.6.4",
        "@vitest/coverage-v8": "^5.0.5",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "vitest": "^5.0.5"
    }
}
