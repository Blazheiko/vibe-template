APP_NAME=uwebsockets-api
APP_KEY=
APP_ENV=local
# Explicit production classifier for security-sensitive fail-fast checks.
# Leave empty in local/dev if APP_ENV naming is reliable.
# Set to true in any production-like deployment, even if APP_ENV uses a custom
# value such as "prod-eu", "live", "prd", or "staging-prod".
# Production deploy manifests / Docker / Helm values should set this explicitly.
APP_IS_PRODUCTION=false
APP_URL=http://localhost:3000
## Public frontend app URL used in user-facing links (for example email verification pages).
FRONTEND_URL=http://localhost:5173
# Public frontend URL used for referral links.
LANDING_URL=http://localhost:5173
PORT=3000
HOST=0.0.0.0
DOMAIN=127.0.0.1:3000
# Listen on a unix socket instead of HOST:PORT when set.
APP_UNIX_PATH=
# URL prefix for HTTP API and WebSocket routes.
API_PATH_PREFIX=api
ENABLED_CORS=true
CREDENTIONALS_CORS=false

# Serve the built frontend from ./public (production). In dev Vite serves it, so keep false.
SERVE_STATIC=false
# Static files above this size, or past the total budget, are streamed from disk (bytes).
STATIC_MAX_MEMORY_FILE_SIZE=1048576
STATIC_MAX_MEMORY_TOTAL=67108864
DOC_PAGE=true

# Request body limits in bytes (2 MB, 2 MB, 50 MB, 50 MB).
APP_MAX_BODY_SIZE=2097152
APP_MAX_JSON_BODY_SIZE=2097152
APP_MAX_MULTIPART_BODY_SIZE=52428800
APP_MAX_OCTET_BODY_SIZE=52428800

# Content-Security-Policy. One mode for all responses: HTML gets the full policy,
# SVG and API responses a strict one, /service-worker.js none.
CSP_ENABLED=true
# true → every global policy is sent as Content-Security-Policy-Report-Only.
CSP_REPORT_ONLY=false
# Optional absolute http(s) URL (path allowed) that receives violation reports.
CSP_REPORT_URI=
# HTTP API origin the browser calls (= frontend VITE_BASE_URL). Default: origin of APP_URL.
CSP_API_ORIGIN=
# WebSocket origin. Default: origin of getWsUrl() (DOMAIN + APP_ENV). Set behind a proxy.
CSP_WS_ORIGIN=
# Sentry ingest origin from VITE_SENTRY_DSN, e.g. https://o0.ingest.sentry.io
CSP_SENTRY_ORIGIN=
# Extra comma-separated origins: connect-src accepts http(s)/ws(s), img-src http(s).
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_IMG_SRC=

# PostgreSQL (needs the pgvector extension). Empty values fall back to these defaults,
# shared by the app, db:create and drizzle-kit (src/config/database.ts).
DB_CONNECTION="pg"
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=postgres
PGSQL_PASSWORD=postgres
PGSQL_DB_NAME=vibe_template
# Encryption of the PostgreSQL connection: false | true (TLS, certificate verified) | require
# (TLS, certificate not verified). Production-like environments warn on false.
PGSQL_SSL=false

# Demo accounts for `db:seed --demo` only (local/dev). Leave empty otherwise.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_IGNORE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=

CDN_URL=

REDIS_HOST="127.0.0.1"
REDIS_PASSWORD=
REDIS_PORT=6379
# Max 16 chars: letters, digits, ":", "_", "-".
REDIS_PREFIX="uwebsocket:"
# Main client (sessions, WS tokens): command timeout, ms. While Redis is slow or
# down, requests fail fast with 503 service_unavailable instead of hanging.
REDIS_COMMAND_TIMEOUT_MS=500
# Whole SCAN/DEL loop of logoutAll, ms; past it the request gets 503 (repeat to finish).
REDIS_LOGOUT_ALL_DEADLINE_MS=2000

# Generate with: pnpm --filter backend push:vapid --write
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:example@gmail.com"
# Comma-separated whitelist of origins allowed for cross-origin requests.
# No wildcards — list full origins. Empty means no cross-origin access.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
# CSRF violations are rejected with 403 by default. false switches to report-only
# (violations are only logged) — a diagnostic/rollback switch, not a normal setting.
CSRF_ENFORCE=true
# Comma-separated list of exact origins (scheme://host[:port], no path or trailing
# slash) allowed by CSRF Origin/Referer checks. Required in production-like
# environments (APP_ENV/NODE_ENV=production|prod or APP_IS_PRODUCTION=true): the
# server refuses to start without it. Elsewhere an empty list falls back to the
# origins of APP_URL and FRONTEND_URL.
CSRF_ALLOWED_ORIGINS=
# Reject unsafe requests that have neither Origin nor Referer. Browsers always send
# Origin on fetch POST/PUT/PATCH/DELETE; set false only for tested legacy clients.
CSRF_STRICT_ORIGIN=true
# Enable the __Host- prefix on the session cookie. Requires HTTPS and APP_URL
# starting with https:// — the server refuses to start otherwise.
# Defaults to APP_IS_PRODUCTION; set explicitly for staging/preview environments.
SESSION_COOKIE_HOST_PREFIX=false
# Lifetime of an anonymous session (signed cookie, or its Redis record once it stores
# data), sliding with use. Duration: 2h, 30m, ...
SESSION_ANON_TTL=2h
# Deadline of the users.session_token lookup made for every authenticated request (ms, 1-60000).
# A database that does not answer in time gives 503 instead of a request that waits, and the
# stuck query is cancelled on the server (statement_timeout of a dedicated 5-connection pool,
# which comes on top of the main pool of 10: leave room for both in max_connections).
SESSION_TOKEN_CHECK_TIMEOUT_MS=2000
# Trust X-Forwarded-For / X-Real-IP only when requests arrive through a trusted
# proxy or load balancer. Keep false unless you explicitly run behind one.
TRUST_PROXY=false
# Comma-separated exact IPs or CIDRs for ingress proxies allowed to supply
# forwarded client IP headers. Example: 10.0.0.0/8,192.168.1.10/32
# Expected proxy behavior: append to X-Forwarded-For and keep origin reachable
# only through trusted proxies/load balancers.
TRUSTED_PROXY_CIDRS=

# Rate limits, two levels:
# - memory: per process, protects the instance from frequent heavy work; with N
#   instances the effective budget is N x. MAX=0 disables; WINDOW_MS > 0.
# - Redis: shared by all instances, for sensitive actions (config/throttle-policies.ts).
# L1 (memory): every API request from one IP, fixed window.
HTTP_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
HTTP_GLOBAL_RATE_LIMIT_MAX=600
# WebSocket upgrade level 1 (memory): per-process flood filter before any I/O.
WS_UPGRADE_RATE_LIMIT_WINDOW_MS=60000
WS_UPGRADE_RATE_LIMIT_MAX=120
# WebSocket upgrade level 2 (Redis): cluster-wide per-IP budget. MAX=0 disables it
# (e.g. a single instance); on a Redis error it is skipped and level 1 applies.
WS_UPGRADE_SHARED_RATE_LIMIT_WINDOW_MS=60000
WS_UPGRADE_SHARED_RATE_LIMIT_MAX=60
# Support chat, per user: messages and chat openings per window (ms). Each message costs
# several language-model calls. Over the limit the reply to the request is a 429.
SUPPORT_CHAT_USER_RATE_LIMIT_MAX=20
SUPPORT_CHAT_USER_RATE_LIMIT_WINDOW_MS=60000
SUPPORT_OPEN_CHAT_USER_RATE_LIMIT_MAX=5
SUPPORT_OPEN_CHAT_USER_RATE_LIMIT_WINDOW_MS=60000
# How often (ms, 100-3600000) each instance re-reads, from the database, the role of its admin
# WebSocket connections. An admin demoted in the database loses the admin channel and the admin
# WS routes on an open connection within this time.
WS_ADMIN_RECHECK_INTERVAL_MS=30000
# Command timeout of the separate Redis connection used by shared limits (same server).
RATE_LIMIT_REDIS_TIMEOUT_MS=50

# Auth / phone verification feature flags
# Requires email confirmation before email registration returns an authenticated session.
# Set false to authenticate new email users immediately and let them confirm email later.
AUTH_STRICT_REGISTRATION=true
# Enables login/register/link/reset phone flows.
AUTH_PHONE_ENABLED=false
# Backend SMS provider selector.
# Supported today:
# - unsupported : safe default, phone flows fail closed
# - fake        : local/test only, deterministic code from AUTH_FAKE_SMS_CODE
AUTH_SMS_PROVIDER=unsupported
# Optional dedicated secret for HMAC hashing SMS verification codes at rest.
# If empty, APP_KEY is used instead. Must be at least 32 characters when phone
# auth is enabled.
AUTH_OTP_HMAC_KEY=
# Explicit override required before fake SMS provider can start.
AUTH_SMS_PROVIDER_ALLOW_FAKE=false
# Required when AUTH_SMS_PROVIDER=fake. Must be set explicitly even in local/test.
# Demo/dev-only value below; do not use fake provider in production-like environments.
AUTH_FAKE_SMS_CODE=123456
# Challenge lifetime in seconds for SMS registration/link/reset flows.
AUTH_SMS_CHALLENGE_TTL_SECONDS=600
# Minimum wait before requesting another SMS for the same flow/phone.
AUTH_SMS_RESEND_COOLDOWN_SECONDS=60
# Per-challenge invalid confirmation attempts before the challenge is invalidated.
AUTH_SMS_MAX_INVALID_ATTEMPTS=5
# Per-IP confirm attempts per hour for SMS code confirmation endpoints.
AUTH_SMS_MAX_CONFIRM_ATTEMPTS_PER_IP_PER_HOUR=20
# Cross-flow SMS send budget per phone number per hour.
AUTH_SMS_MAX_SENDS_PER_PHONE_PER_HOUR=3
# Per-IP SMS start/send budget per hour.
AUTH_SMS_MAX_SENDS_PER_IP_PER_HOUR=10
# Generic email registration throttle: per-target email budget per hour.
AUTH_EMAIL_REGISTER_MAX_ATTEMPTS_PER_EMAIL_PER_HOUR=3
# Generic email registration throttle: per-IP budget per hour.
AUTH_EMAIL_REGISTER_MAX_ATTEMPTS_PER_IP_PER_HOUR=10
# Email-link throttle: sends per target email per hour.
AUTH_EMAIL_LINK_MAX_ATTEMPTS_PER_TARGET_PER_HOUR=3
# Email-link throttle: sends per authenticated user per hour.
AUTH_EMAIL_LINK_MAX_ATTEMPTS_PER_USER_PER_HOUR=3
# Email-link minimum interval between repeated sends by the same user.
AUTH_EMAIL_LINK_COOLDOWN_SECONDS=60
# Shared (Redis) auth limits. 0 is rejected at startup: these protections cannot be disabled.
# Login: every attempt counts, before the user lookup; the identifier budget resets
# after a successful login and is higher than the IP budget (lockout protection).
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
AUTH_LOGIN_MAX_ATTEMPTS_PER_IDENTIFIER=40
AUTH_LOGIN_WINDOW_SECONDS=900
# Change password: attempts per user before the current-password check.
AUTH_CHANGE_PASSWORD_MAX_ATTEMPTS_PER_USER=10
AUTH_CHANGE_PASSWORD_WINDOW_SECONDS=900
# Forgot password (email): requests per hour, checked before the address lookup.
AUTH_FORGOT_PASSWORD_MAX_REQUESTS_PER_IP_PER_HOUR=10
AUTH_FORGOT_PASSWORD_MAX_REQUESTS_PER_EMAIL_PER_HOUR=3
# Resend verification email: per user per hour.
AUTH_RESEND_VERIFICATION_MAX_PER_USER_PER_HOUR=3
# Unverified account, right password at login: the login answers 401 like a wrong password and the
# verification mail is sent again at most once per this interval (ms) per account.
AUTH_LOGIN_UNVERIFIED_RESEND_INTERVAL_MS=300000
# Token guessing on reset-password and verify-email: per IP per hour.
AUTH_RESET_PASSWORD_MAX_ATTEMPTS_PER_IP_PER_HOUR=20
AUTH_VERIFY_EMAIL_MAX_ATTEMPTS_PER_IP_PER_HOUR=20

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_PREFIX=app
S3_STATIC_DATA_PREFIX=public
S3_DYNAMIC_DATA_PREFIX=uploads

SENTRY_DSN=
SENTRY_ENABLED=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Reaction to a broken response contract (handler result vs the route ResponseSchema).
# The schema runs on every response; there is no off mode.
#   strict - a schema mismatch or a key undeclared in the schema becomes 500
#            internal_error (default outside production)
#   log    - a schema mismatch becomes 500; undeclared keys are stripped from the
#            response and a warn is logged with their paths, without values
#            (default in production)
RESPONSE_VALIDATION_CONTRACT=
# Per-check timeout of GET /ready (PostgreSQL, Redis), ms.
READINESS_CHECK_TIMEOUT_MS=1000

# Text AI provider: openai | xai | mistral (anything else stops the start).
AI_TEXT_DRIVER=openai
# Upper bound for one AI provider call, ms (>= 1000). Exceeding it -> 504 upstream_timeout.
AI_REQUEST_TIMEOUT_MS=60000
# Support chat: tokens one user may spend per UTC day (0 switches the budget off; production
# refuses 0 at startup). A message reserves an estimate and is settled with the provider's usage.
AI_SUPPORT_DAILY_TOKEN_BUDGET=200000
# Tokens a reply is allowed to add to the message for what is unknown at admission: the system
# prompt, the knowledge-base context and the chat history.
AI_SUPPORT_PROMPT_ALLOWANCE_TOKENS=8000
# Prompt cache TTL per process, ms: other instances see a prompt update within it.
PROMPT_CACHE_TTL_MS=60000

# Support AI: answer language when the client sends none (an app locale code),
# articles per embeddings request when reindexing, max cosine distance (0..2]
# of an article used as context.
SUPPORT_DEFAULT_LANGUAGE=en
SUPPORT_EMBEDDING_BATCH_SIZE=50
SUPPORT_SEARCH_MAX_DISTANCE=0.8

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

XAI_API_KEY=
XAI_CHAT_MODEL=grok-4-1-fast-non-reasoning

MISTRAL_API_KEY=
MISTRAL_TEXT_MODEL=mistral-medium-latest

# OAuth providers: a provider is usable once its client id, secret and redirect URI are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=
# Where the browser lands after OAuth (absolute URL or path on the frontend).
OAUTH_FRONTEND_SUCCESS_URL=/?oauth=success
OAUTH_FRONTEND_ERROR_URL=/?error=oauth_failed

# TURN server for WebRTC (src/config/turn.ts; nothing imports it yet).
TURN_SECRET=
TURN_HOST=
