{
    "name": "landing",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24.22.2"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --build && vite build --ssr src/entry-server.ts --outDir dist-ssr && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --build --force && tsc --noEmit -p e2e/tsconfig.json",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write src/ build/ e2e/",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "shared": "workspace:*",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-vue": "~10.12.0",
        "jiti": "^2.7.0",
        "typescript": "6.0.3",
        "vite": "^7.3.7",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.14"
    }
}
