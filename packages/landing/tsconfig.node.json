{
    "extends": "@tsconfig/node24/tsconfig.json",
    "include": [
        "vite.config.*",
        "vitest.config.*",
        "playwright.config.*",
        "eslint.config.*",
        "build/**/*.ts"
    ],
    "exclude": ["build/**/__tests__/*"],
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"]
    }
}
